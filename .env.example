# ===== المعلم الذكي (Claude API) =====
# يُقرأ في الخادم فقط ولا يُرسل إلى المتصفح أبداً
ANTHROPIC_API_KEY=
# النموذج الافتراضي (يمكن تغييره من لوحة الإدارة)
AI_MODEL=claude-opus-5-5

# ===== لوحة الإدارة =====
# كلمة مرور المدير (إلزامية لتفعيل لوحة الإدارة)
ADMIN_PASSWORD=
# كلمة مرور المعلم (اختيارية) – صلاحيات المحتوى دون إعدادات الذكاء الاصطناعي
TEACHER_PASSWORD=
# سر توقيع الجلسات: سلسلة عشوائية طويلة (32 حرفاً على الأقل)
SESSION_SECRET=

# ===== التخزين السحابي (اختياري) =====
# إن لم تُضبط، تُحفظ بيانات الإدارة في الملف data/store.json (للتشغيل المحلي فقط)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
